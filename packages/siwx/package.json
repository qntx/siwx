{
  "name": "@qntx/siwx",
  "version": "0.8.0",
  "description": "Sign-In with X (CAIP-122) for TypeScript: SIWE, SIWS, message parsing, validation, and signature verification.",
  "keywords": [
    "authentication",
    "caip-122",
    "ethereum",
    "sign-in",
    "siwe",
    "siws",
    "siwx",
    "solana"
  ],
  "homepage": "https://github.com/qntx/siwx#readme",
  "bugs": {
    "url": "https://github.com/qntx/siwx/issues"
  },
  "license": "MIT OR Apache-2.0",
  "author": "QuantX <x@qntx.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qntx/siwx.git",
    "directory": "packages/siwx"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./evm": {
      "types": "./dist/evm.d.mts",
      "import": "./dist/evm.mjs",
      "default": "./dist/evm.mjs"
    },
    "./svm": {
      "types": "./dist/svm.d.mts",
      "import": "./dist/svm.mjs",
      "default": "./dist/svm.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.src.json",
    "check:pkg": "vp pack && publint && attw --pack . --profile esm-only",
    "prepublishOnly": "vp run build",
    "smoke:hermes": "bun scripts/hermes-smoke.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@qntx/tsconfig": "1.0.1",
    "@types/node": "26.6.5",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
